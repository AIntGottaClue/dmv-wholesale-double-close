---
import { trustBar, fees, cities } from '../data/cities';
import type { Step, Faq } from '../data/cities';
import DealForm from './DealForm.astro';
import FaqAccordion from './FaqAccordion.astro';
interface Props { h1Bottom:string;hero:string;localNoteTitle:string;localNote:string;whyHeading:string;why:string[];steps:Step[];faqs:Faq[];formName:string;cityName:string;stateAbbr:string;showCityGrid?:boolean; }
const {h1Bottom,hero,localNoteTitle,localNote,whyHeading,why,steps,faqs,formName,cityName,stateAbbr,showCityGrid=false}=Astro.props;
const locationValue = showCityGrid ? "Homepage" : (cityName.includes(",") ? cityName : `${cityName}, ${stateAbbr}`);
---
<section class="hero" aria-labelledby="hero-title"><div class="hero__graphic" aria-hidden="true"><span class="hero__stripe hero__stripe--1"></span><span class="hero__stripe hero__stripe--2"></span><span class="hero__stripe hero__stripe--3"></span></div><div class="container hero__inner"><div class="hero__content"><h1 class="hero__title" id="hero-title"><span class="hero__line">Wholesale Double Close Funding</span><span class="hero__line hero__line--accent">{h1Bottom}</span></h1><p class="hero__subtitle">{hero}</p></div><DealForm formName={formName} cityName={cityName} locationValue={locationValue} /></div></section>
<section class="trust-bar" aria-label="Funding highlights"><div class="container trust-bar__inner">{trustBar.map(t=><div class="trust-bar__item"><span class="trust-bar__icon" aria-hidden="true">✓</span>{t}</div>)}</div></section>
<section class="section" id="funding-fees"><div class="container"><h2 class="section__title">Clear fees. No surprises.</h2><p class="section__intro">Fees are flat and published so you can underwrite the funding cost into your offer before you tie up the property.</p><div class="funding-fees__layout"><div class="fee-table-wrap"><table class="fee-table"><caption class="sr-only">Double-close funding fee schedule</caption><thead><tr><th scope="col">Funding Amount</th><th scope="col">Fee or Detail</th></tr></thead><tbody>{fees.map(f=><tr><th scope="row">{f.label}</th><td>{f.detail}</td></tr>)}</tbody></table></div></div></div></section>
<section class="local-note" aria-labelledby="local-note-title"><div class="container local-note__inner"><div class="local-note__marker" aria-hidden="true">{stateAbbr}</div><div class="local-note__body"><h2 class="local-note__title" id="local-note-title">{localNoteTitle}</h2><p>{localNote}</p></div></div></section>
<section class="why-us section" id="why-us"><div class="container"><h2 class="section__title">{whyHeading}</h2><p class="why-us__intro">{why[0]}</p><div class="why-us__grid">{why.slice(1).map((text,i)=><article class="feature-card"><div class="feature-card__icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</div><p class="feature-card__text">{text}</p></article>)}</div></div></section>
<section class="section section--dark" id="how-it-works"><div class="container"><h2 class="section__title">Three steps from contract to close</h2><ol class="steps">{steps.map((s,i)=><li class="step"><span class="step__num">{i+1}</span><h3 class="step__title">{s.title}</h3><p class="step__text">{s.text}</p></li>)}</ol></div></section>
<section class="section section--tint" id="faq"><div class="container faq__inner"><h2 class="section__title">Questions wholesalers ask</h2><FaqAccordion items={faqs} /></div></section>
{showCityGrid&&<section class="section" id="service-areas"><div class="container"><h2 class="section__title">Service Areas Across the DMV</h2><p class="section__intro">We connect wholesalers with double close funding across every county in the Washington metro, from the District and close-in Maryland suburbs to the outer counties of Northern Virginia. Each service area page covers the local housing stock, the closing process, and how funding works in that city.</p><div class="city-grid">{cities.map(c=><a class="city-card" href={`/${c.slug}/`}><h3>{c.name}</h3><p class="city-card__county">{c.county}</p><p>{c.blurb}</p></a>)}</div></div></section>}
<section class="final-cta"><div class="final-cta__graphic" aria-hidden="true"></div><div class="container final-cta__inner"><h2 class="final-cta__title">Ready to fund your {cityName} double closing?</h2><p class="final-cta__text">Submit the deal and we will review the numbers. Funding can be ready in as little as 24 hours once we have the deal details and closing office information.</p><a class="btn btn--accent btn--lg" href="#deal-form">Submit Your Deal <span aria-hidden="true">→</span></a></div></section>
