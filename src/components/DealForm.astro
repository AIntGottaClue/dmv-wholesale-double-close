---
interface Props { formName: string; cityName: string; locationValue?: string }
const { formName, cityName, locationValue = cityName } = Astro.props;
---
<div class="hero__form-card" id="deal-form">
 <div class="form-intro"><h2 class="hero__form-title">Submit your {cityName} deal</h2><p class="hero__form-note">Tell us what you have under contract. We'll review it and get back to you.</p></div>
 <form id={formName} name={formName} class="deal-form" method="POST" novalidate>
  <input type="text" class="deal-form__ghost" name="wdc_location" value={locationValue} tabindex="-1" aria-hidden="true" readonly/>
  <input type="hidden" name="wdc_site" value="DMV" />
  <div class="deal-form__trap" aria-hidden="true"><label for="wdc_website">Website</label><input id="wdc_website" name="website" type="text" tabindex="-1" autocomplete="off"/></div>
  <div class="deal-form__field"><label for="full_name">Name</label><input id="full_name" name="full_name" type="text" autocomplete="name" required /></div>
  <div class="deal-form__row"><div class="deal-form__field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></div><div class="deal-form__field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div></div>
  <div class="deal-form__field"><label for="wdc_details">Tell us about your deal</label><textarea id="wdc_details" name="wdc_detials" rows="4" placeholder="Property address, A-B price, B-C price, target closing date" required></textarea></div>
  <button class="btn btn--accent btn--block deal-form__submit" type="submit">Get My Deal Funded <span aria-hidden="true">→</span></button><p class="deal-form__fine">By submitting, you agree we may contact you about your deal. See our <a href="/privacy/">Privacy Policy</a>.</p>
 </form>
 <div class="deal-success" id="deal-success" role="status" aria-live="polite" tabindex="-1" hidden><svg class="deal-success__icon" viewBox="0 0 64 64" width="72" height="72" aria-hidden="true"><circle cx="32" cy="32" r="28" fill="none" stroke="currentColor" stroke-width="5"/><path d="M21 33.5l7.5 7.5L43.5 25" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/></svg><h2 class="deal-success__title">Deal Received</h2><p class="deal-success__text">We have your {cityName} deal and will review the numbers. Watch your phone and email for a response.</p><button type="button" class="deal-success__again">Submit another deal</button></div>
</div>
<script is:inline>
(function(){var form=document.querySelector('.hero__form-card form');if(!form)return;var phone=form.querySelector('input[name="phone"]'),success=document.getElementById('deal-success'),card=form.closest('.hero__form-card');function normalize(){var d=phone.value.replace(/\D/g,'');if(d.length===11&&d.charAt(0)==='1')d=d.slice(1);if(d.length===10&&/^[2-9]\d{2}[2-9]\d{6}$/.test(d)){phone.value='+1'+d;phone.setCustomValidity('');return true}phone.setCustomValidity('Please enter a 10-digit US phone number.');return false}phone.addEventListener('blur',normalize);phone.addEventListener('input',function(){phone.setCustomValidity('')});window.addEventListener('submit',function(e){if(e.target===form)normalize()},true);form.addEventListener('submit',function(e){e.preventDefault();normalize();var bad=Array.from(form.querySelectorAll('[required]')).find(function(el){return !el.checkValidity()});if(bad){bad.reportValidity();bad.focus();return}var btn=form.querySelector('button[type="submit"]');btn.disabled=true;setTimeout(function(){form.hidden=true;card.querySelector('.form-intro').hidden=true;success.hidden=false;success.scrollIntoView({behavior:'smooth',block:'center'});success.focus({preventScroll:true});card.classList.add('is-success');btn.disabled=false},800)});card.querySelector('.deal-success__again').addEventListener('click',function(){form.reset();success.hidden=true;form.hidden=false;card.querySelector('.form-intro').hidden=false;card.classList.remove('is-success');form.querySelector('input[name="full_name"]').focus()})})();
</script>

