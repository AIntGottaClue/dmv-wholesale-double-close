---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import { cities, brand, domain } from '../data/cities';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { slug: c.slug }, props: { city: c } }));
}
const { city } = Astro.props;

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "name": brand,
    "url": `https://${domain}/${city.slug}/`,
    "areaServed": {
      "@type": "City",
      "name": city.name,
      "containedInPlace": { "@type": "State", "name": city.stateName }
    },
    "description": `Transactional double close funding for real estate wholesalers in ${city.name}.`
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Wholesale double close transactional funding",
    "provider": { "@type": "FinancialService", "name": brand },
    "areaServed": { "@type": "City", "name": city.name, "containedInPlace": { "@type": "State", "name": city.stateName } }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": city.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://${domain}/` },
      { "@type": "ListItem", "position": 2, "name": `${city.name}, ${city.state}`, "item": `https://${domain}/${city.slug}/` }
    ]
  }
];
---
<Base title={city.title} description={city.description} path={`/${city.slug}/`} jsonld={jsonld}>
  <Header base={`/${city.slug}`} />
  <main>
    <CityContent
      h1Bottom={city.h1Bottom}
      hero={city.hero}
      localNoteTitle={city.localNoteTitle}
      localNote={city.localNote}
      whyHeading={city.whyHeading}
      why={city.why}
      steps={city.steps}
      faqs={city.faqs}
      formName={city.formName}
      cityName={city.name}
      stateAbbr={city.state}
    />
  </main>
  <Footer />
</Base>
